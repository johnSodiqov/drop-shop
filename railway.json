{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "npm run db:generate && npm run build --workspace @dropstore/backend"
  },
  "deploy": {
    "preDeployCommand": ["npm run db:deploy --workspace @dropstore/backend"],
    "startCommand": "npm run start:prod --workspace @dropstore/backend",
    "healthcheckPath": "/api/v1/health"
  }
}
