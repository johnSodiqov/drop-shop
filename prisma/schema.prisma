generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  AGENT
  CUSTOMER
}

enum ProductStatus {
  ACTIVE
  HIDDEN
  ARCHIVED
  OUT_OF_STOCK
}

enum OrderStatus {
  NEW
  CONFIRMED
  PACKING
  DELIVERY
  DELIVERED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum PaymentMethod {
  CASH
  CARD_ON_DELIVERY
  TRANSFER_AGENT
}

model User {
  id              String         @id @default(cuid())
  phone           String         @unique
  name            String
  passwordHash    String
  role            UserRole       @default(CUSTOMER)
  isActive        Boolean        @default(true)
  refreshTokenHash String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)
  agentProfile    AgentProfile?
  customerOrders  Order[]        @relation("CustomerOrders")
  agentOrders     Order[]        @relation("AgentOrders")
  statusChanges   OrderStatusHistory[]
  auditLogs       AuditLog[]

  @@index([role, isActive])
}

model AgentProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  referralCode  String   @unique
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  imageUrl  String?
  imageKey  String?
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @db.Timestamptz(3)
  products  Product[]
}

model Product {
  id                    String        @id @default(cuid())
  sku                   String        @unique
  name                  String
  description           String
  imageUrl              String?
  imageUrls             String[]      @default([])
  imageKeys             String[]      @default([])
  costPrice             Decimal       @db.Decimal(12, 2)
  recommendedPrice      Decimal       @db.Decimal(12, 2)
  minimumPrice          Decimal       @db.Decimal(12, 2)
  maximumMarkup         Decimal       @db.Decimal(12, 2)
  allowAgentPriceChange Boolean       @default(true)
  status                ProductStatus @default(ACTIVE)
  categoryId            String
  createdAt             DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime      @updatedAt @db.Timestamptz(3)
  category              Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  inventory             Inventory?
  inventoryMovements    InventoryMovement[]
  orderItems            OrderItem[]

  @@index([categoryId, status])
  @@index([status, createdAt])
}

model Inventory {
  id        String   @id @default(cuid())
  productId String   @unique
  quantity  Int      @default(0)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model InventoryMovement {
  id          String   @id @default(cuid())
  productId   String
  orderId     String?
  quantity    Int
  reason      String
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, createdAt])
  @@index([orderId])
}

model Order {
  id             String                @id @default(cuid())
  orderNumber    Int                   @unique @default(autoincrement())
  customerId     String?
  agentId        String?
  customerName   String
  customerPhone  String
  deliveryAddress String
  deliveryLatitude Float?
  deliveryLongitude Float?
  paymentMethod   PaymentMethod       @default(CASH)
  comment        String?
  status         OrderStatus           @default(NEW)
  totalAmount    Decimal               @db.Decimal(12, 2)
  totalCost      Decimal               @db.Decimal(12, 2)
  totalProfit    Decimal               @db.Decimal(12, 2)
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime              @updatedAt @db.Timestamptz(3)
  customer       User?                 @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: SetNull)
  agent          User?                 @relation("AgentOrders", fields: [agentId], references: [id], onDelete: SetNull)
  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  inventoryMovements InventoryMovement[]
  notifications  NotificationLog[]

  @@index([customerId, createdAt])
  @@index([agentId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id               String   @id @default(cuid())
  orderId          String
  productId        String
  productName      String
  sku              String
  quantity         Int
  costPrice        Decimal  @db.Decimal(12, 2)
  salePrice        Decimal  @db.Decimal(12, 2)
  profit           Decimal  @db.Decimal(12, 2)
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  changedBy String
  from      OrderStatus
  to        OrderStatus
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [changedBy], references: [id], onDelete: Restrict)

  @@index([orderId, createdAt])
}

model NotificationLog {
  id            String             @id @default(cuid())
  orderId       String
  event         String
  status        NotificationStatus @default(PENDING)
  attempts      Int                @default(0)
  nextAttemptAt DateTime           @default(now()) @db.Timestamptz(3)
  lastError     String?
  sentAt        DateTime?          @db.Timestamptz(3)
  createdAt     DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime           @updatedAt @db.Timestamptz(3)
  order         Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([orderId, createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  target    String
  details   Json?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([target, createdAt])
}
